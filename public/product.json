{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "Playground API",
  "slug": "playground-api",
  "version": "1.0.0",
  "category": [
    "mock-api",
    "api-sandbox",
    "developer-tool",
    "testing-tool",
    "graphql-sandbox"
  ],
  "description": "Free, zero-configuration, stateful mock REST and GraphQL API sandbox for frontend development, prototyping, and testing.",
  "website": "https://playground.nileslabs.com",
  "documentation": "https://playground.nileslabs.com/docs",
  "repository": "https://github.com/nileslabs/playground_api",
  "license": "MIT",
  "api": {
    "base_url": "https://playground.nileslabs.com/api/v1",
    "rest": true,
    "graphql": true,
    "graphql_endpoint": "https://playground.nileslabs.com/api/v1/graphql"
  },
  "authentication": {
    "required": false,
    "jwt_simulation": true,
    "login_endpoint": "/auth/login",
    "refresh_endpoint": "/auth/refresh",
    "profile_endpoint": "/auth/me"
  },
  "state": {
    "persistent": true,
    "session_scoped": true,
    "global_seed_data_mutable": false,
    "retention_days": 10,
    "max_overlay_records_per_resource": 30,
    "reset_endpoint": "/session/reset",
    "snapshot_export_endpoint": "/session/snapshot",
    "snapshot_import_endpoint": "/session/snapshot"
  },
  "features": [
    "stateful-crud-persistence",
    "pagination",
    "cursor-pagination",
    "relational-filtering",
    "full-text-search",
    "multi-field-sorting",
    "network-delay-simulation",
    "http-error-simulation",
    "custom-collections",
    "svg-avatar-generation",
    "svg-thumbnail-generation",
    "jwt-auth-simulation",
    "graphql-gateway",
    "session-snapshots",
    "openapi-export",
    "postman-export",
    "bruno-export",
    "insomnia-export",
    "typescript-definitions"
  ],
  "collections": [
    { "name": "posts", "path": "/posts", "count": 100, "relational": ["user_id", "comments"] },
    { "name": "comments", "path": "/comments", "count": 300, "relational": ["post_id"] },
    { "name": "users", "path": "/users", "count": 25, "relational": ["posts", "todos"] },
    { "name": "todos", "path": "/todos", "count": 125, "relational": ["user_id", "completed"] },
    { "name": "auth", "path": "/auth", "type": "JWT Simulation" },
    { "name": "custom", "path": "/custom/:collection", "type": "Dynamic Schema-less" },
    { "name": "avatars", "path": "/avatars/:seed", "type": "Vector SVG Generator" },
    { "name": "thumbnails", "path": "/thumbnails/:seed", "type": "Vector SVG Image Helper" }
  ],
  "audience": [
    "frontend-developers",
    "mobile-developers",
    "qa-engineers",
    "educators",
    "ai-coding-agents"
  ],
  "specs": {
    "openapi": "https://playground.nileslabs.com/api/v1/downloads/openapi.json",
    "postman": "https://playground.nileslabs.com/api/v1/downloads/postman.json",
    "bruno": "https://playground.nileslabs.com/api/v1/downloads/bruno.json",
    "insomnia": "https://playground.nileslabs.com/api/v1/downloads/insomnia.json",
    "typescript": "https://playground.nileslabs.com/api/v1/downloads/playground-api.d.ts",
    "llms": "https://playground.nileslabs.com/llms.txt",
    "llms_full": "https://playground.nileslabs.com/llms-full.txt"
  }
}
